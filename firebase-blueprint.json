      "title": "TechnicianCredential",
      "description": "Private technician certificate, license, or degree document stored in Firebase Storage and linked in Firestore for admin verification.",
      "type": "object",
      "properties": {
        "technicianId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "technicianName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "docType": { "type": "string", "enum": ["Certificate", "License", "Degree"] },
        "title": { "type": "string", "minLength": 2, "maxLength": 140 },
        "issuer": { "type": "string", "maxLength": 120 },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "mimeType": { "type": "string", "minLength": 3, "maxLength": 80 },
        "fileSize": { "type": "number" },
        "storagePath": { "type": "string", "maxLength": 400 },
        "downloadUrl": { "type": "string", "maxLength": 2000 },
        "fileDataUrl": { "type": "string", "minLength": 10, "maxLength": 200000 },
        "verificationStatus": { "type": "string", "enum": ["Pending", "Verified", "Rejected"] },
        "adminNote": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["technicianId", "technicianName", "docType", "title", "fileName", "mimeType", "verificationStatus", "createdAt", "updatedAt"]
    },
    "TechnicianReview": {
      "title": "TechnicianReview",
      "description": "Verified customer star rating and text review created after a completed technician booking.",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "technicianId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "technicianName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "customerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "skillCategory": { "type": "string", "minLength": 2, "maxLength": 64 },
        "clusterZone": { "type": "string", "minLength": 2, "maxLength": 64 },
        "rating": { "type": "number" },
        "reviewText": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bookingId", "technicianId", "technicianName", "customerId", "customerName", "skillCategory", "clusterZone", "rating", "reviewText", "createdAt", "updatedAt"]
    },
    "SavedFavorite": {
      "title": "SavedFavorite",
      "description": "User-bookmarked favorite technician, contractor, or shop profile stored under the user's private subcollection.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetType": { "type": "string", "enum": ["technician", "contractor", "shop"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "category": { "type": "string", "maxLength": 80 },
        "clusterZone": { "type": "string", "minLength": 2, "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "targetType", "targetId", "targetName", "clusterZone", "createdAt"]
    },
    "UserWallet": {
      "title": "UserWallet",
      "description": "User digital wallet balance and transaction summary.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "balance": { "type": "number" },
        "totalCredited": { "type": "number" },
        "totalSpent": { "type": "number" },
        "lastTransactionRef": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "balance", "totalCredited", "totalSpent", "updatedAt"]
    },
    "UserRewards": {
      "title": "UserRewards",
      "description": "User loyalty points balance and rewards tier.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "pointsBalance": { "type": "number" },
        "lifetimeEarned": { "type": "number" },
        "lifetimeRedeemed": { "type": "number" },
        "tier": { "type": "string", "enum": ["Silver", "Gold", "Platinum"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "pointsBalance", "lifetimeEarned", "lifetimeRedeemed", "tier", "updatedAt"]
    }
  },
